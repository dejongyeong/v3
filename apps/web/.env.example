PORT=3000
NODE_ENV=development

# NestJS specific environment variables can be added here
# Base URL for the NestJS API (used by the web application to communicate with the API)
NEST_API_BASE_URL=http://localhost:3001

# NestJS API signing private key (used to verify the authenticity of API responses)
# Generated using a secure method, this key is used to sign API responses. Keep it secret.
# Command: openssl pkey -in nest-api-private.pem -pubout -out nest-api-public.pem
NEST_API_SIGNING_KEY=your-signing-key-here