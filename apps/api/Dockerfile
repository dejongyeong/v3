# base configuration environment
# use a slim, official production-ready Node.js image
FROM node:26.11.1-bookworm-slim AS base

# install the exact pnpm version pinned by the workspace inside the
# isolated filesystem of the docker container
RUN npm install --global pnpm@12.10.1

# stage 2
# code pruning and installation will follow in subsequent stages
FROM base AS pruner

# set up an isolated, structural  staging area inside the container image
WORKDIR /repo
# copy every piece of monorepo into the staging area
COPY . .
# run turborepo prune command to extract only apps/api code, shared configuration
# packages, and matching pnpm-lock.yaml segments into a clean /out directory
# https://turborepo.dev/docs/guides/tools/docker
RUN pnpm dlx turbo@2.11.7 prune api --docker

# stage 3 - dependency installation and compilation
FROM base AS builder

WORKDIR /repo

# copy the pruned output from the previous stage into the builder stage
# this isolates dependency layer so changes to source code don't break the build cache
COPY --from=pruner /repo/out/json/ ./
# run a secure, locked installation sweep using the stripped, matching monorepo lockfile
RUN pnpm install --frozen-lockfile

# copy full operational source logic of api application and shared dependencies
COPY --from=pruner /repo/out/full/ ./
# trigger global turbo compilation pipeline exclusively targeting the api application
RUN pnpm turbo run build --filter=api
# use pnpm deploy command to automatically handle deployment tasks for the api application, its 
# active internal workspace, and only its production dependencies into a flat deployment structure (/out)
RUN pnpm --filter api --prod deploy /out

# stage 4 - production multi-stage execution environment
FROM node:26.11.1-bookworm-slim AS runner

ENV NODE_ENV=production
# map a dedicated runtime workspace folder for the live server execution context
WORKDIR /app

# copy the lightweight, isolated deployment bundle generated by pnpm deploy
# enforce the official, unprivileged system account group 'node' to own all copies files
COPY --from=builder --chown=node:node /out/ .

# drop root access rights and step into the non-root 'node' user context
USER node
# expose the standard google cloud run public routing port boundary mapping
EXPOSE 8080

# spin up the api service core engine instantly using standard native esm modules
CMD ["node", "dist/main.js"]